{"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Example-App","level":2,"text":"Example App"},{"type":"paragraph","inlineContent":[{"text":"There is an ","type":"text"},{"identifier":"https:\/\/github.com\/systemloco\/Med42-iOS-SDK\/tree\/main\/Med42SDK%20Example","type":"reference","isActive":true},{"text":" that can be referenced.  This demonstrates the main behaviours of the SDK.","type":"text"}]},{"type":"heading","anchor":"API-Keys","level":2,"text":"API Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use the SDK you will be issued with an API Key and Client ID for your application to use. You must use these to configure the SDK before any other interaction. We recommend you do this as part of your application’s AppDelegate. You can provide an custom application identifier that our platform will associate with any data collected."}]},{"type":"heading","anchor":"Installation","level":2,"text":"Installation"},{"type":"heading","anchor":"Swift-Package-Manager","level":3,"text":"Swift Package Manager"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add Med42SDK to your project using Swift Package Manager:"}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/systemloco\/Med42-iOS-SDK\", from: \"1.0.0\")","]"]},{"type":"heading","anchor":"XCode-project","level":3,"text":"XCode project"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Within XCode"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select "},{"type":"codeVoice","code":"File"},{"type":"text","text":" -> "},{"type":"codeVoice","code":"Add Package Dependencies"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter the URL: "},{"code":"https:\/\/github.com\/systemloco\/Med42-iOS-SDK","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"Select ","type":"text"},{"type":"codeVoice","code":"Add Package"}],"type":"paragraph"}]}]},{"anchor":"Configuration","text":"Configuration","type":"heading","level":2},{"anchor":"SDK","text":"SDK","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Configure the SDK with the supplied credentials before use, typically within the App delegate:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Med42SDK","","\/\/ Configure the SDK with your credentials","let config = Med42Configuration(","    apiKey: \"your-api-key\",","    clientId: \"your-client-id\",","    appIdentifier: \"My App (dev)\",","    backgroundUploadTaskIdentifier: \"com.med42.sdk.example.background-upload\"",")","","Med42.configure(with: config)","Med42.shared.initialize()"]},{"inlineContent":[{"code":"initialize()","type":"codeVoice"},{"text":" is typically called immediately after ","type":"text"},{"code":"configure()","type":"codeVoice"},{"text":" but can be deferred. The SDK will not activate until this is called.","type":"text"}],"type":"paragraph"},{"anchor":"Project","text":"Project","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"To support passively collecting and uploading when the user is not actively running the application you need to create a background task in your project and provide the identifier to the SDK."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Configuring your project"}],"type":"strong"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Open the XCode Target for your project","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to “Signing & Cababilities”"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Tick “Background fetch” & “Location updates”","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Go to “Info”"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"BGTaskSchedulerPermittedIdentifiers"},{"type":"text","text":" as an array type in your plist. See "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/using-background-tasks-to-update-your-app","isActive":true}]}]},{"content":[{"inlineContent":[{"text":"Add an entry with a unique task identifier. This is generally your application’s bundle id with a suffix such as ","type":"text"},{"type":"codeVoice","code":".refresh"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".background-upload"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"As the SDK uses location services, you need to make sure your "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" contains explanations for why those permisions are used. The application needs the following keys:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"NSLocationWhenInUseUsageDescription","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSLocationAlwaysAndWhenInUseUsageDescription"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note: These values may already exist in the "},{"type":"codeVoice","code":"Info.plist"},{"text":" if in use already.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"E.g.","type":"text"}]},{"syntax":null,"code":["<key>NSLocationWhenInUseUsageDescription<\/key>","<string>This app needs access to your location to scan for nearby S14BLs.<\/string>","<key>NSLocationAlwaysAndWhenInUseUsageDescription<\/key>","<string>This app needs access to your location in the background to scan for nearby S14BLs even when the app is not in use.<\/string>"],"type":"codeListing"},{"anchor":"Scanning","type":"heading","level":2,"text":"Scanning"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support scanning for System Loco LocoTag S14BLs the user must grant the application location permissions. To passively scan in the background it must be granted the “Always Access” location permission."}]},{"type":"paragraph","inlineContent":[{"text":"We recommend that to improve the application experience, your application can premptively ask for the user for these permissions. If you request to perform a scan and if permissions have not already been requested, the user will be prompted to grant them automatically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK will attempt to upload the data to LocoAware immediately but if this is unsuccessful it is stored for later upload. The SDK seemlesses attempts to upload this data through the background task and\/or future foreground use of the app."}]},{"anchor":"Foreground-Scanning","type":"heading","level":3,"text":"Foreground Scanning"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you provide a delegate, you’ll receive summary information of any LocoTags that are detected."}]},{"type":"paragraph","inlineContent":[{"text":"Implement the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Med42SDK\/documentation\/Med42SDK\/Med42TagScannerDelegate"},{"text":" to receive beacon detection events:","type":"text"}]},{"syntax":"swift","code":["class MyViewController: UIViewController, Med42TagScannerDelegate {","    override func viewDidLoad() {","        super.viewDidLoad()","","        \/\/ Set up the delegate","        Med42.shared.scanDelegate = self","","        \/\/ Set username for tracking - optional","        Med42.shared.username = \"user@example.com\"","","        \/\/ Initialize and start scanning","        Med42.shared.initialize()","        ","        Med42.shared.startForegroundScanning()","    }","","    func didDetectTag(_ tag: Med42Tag) {","        print(\"Detected tag: \\(tag.deviceId)\")","    }","","    func didFailWithError(_ error: Error) {","        print(\"Scanning error: \\(error)\")","    }","}"],"type":"codeListing"},{"anchor":"Background-Scanning","type":"heading","level":3,"text":"Background Scanning"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To enable background scanning, request permissions and register for background uploads:"}]},{"syntax":"swift","code":["\/\/ Request background permissions","Med42.shared.requestBackgroundPermissions()",""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Upon success of "},{"type":"codeVoice","code":"Med42.shared.requestBackgroundPermissions()"},{"type":"text","text":" background monitoring will immediately begin to work."},{"type":"text","text":" "},{"type":"text","text":"On further app starts, the call to "},{"type":"codeVoice","code":"Med42.shared.initialize()"},{"type":"text","text":" will begin the monitoring provided permissions are still granted."}]},{"type":"paragraph","inlineContent":[{"text":"Background monitoring can be manually triggered by calling ","type":"text"},{"type":"codeVoice","code":"Med42.shared.startMonitoring()"}]},{"anchor":"Uploading","type":"heading","level":2,"text":"Uploading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK automatically uploads data through the background task or when the application is run. If your application has specific network handling you can also manually request uploading data and monitor the progress."}]},{"type":"paragraph","inlineContent":[{"text":"Once the SDK is initialised you can manually trigger uploads of collected data by:","type":"text"}]},{"syntax":"swift","code":["\/\/ Set upload delegate","Med42.shared.uploadDelegate = self","","\/\/ Trigger upload","Med42.shared.uploadTags()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Optionally implement "},{"identifier":"doc:\/\/Med42SDK\/documentation\/Med42SDK\/Med42UploadDelegate","type":"reference","isActive":true},{"type":"text","text":" to monitor upload status:"}]},{"syntax":"swift","code":["extension MyViewController: Med42UploadDelegate {","   func uploadDidStart() {","        print(\"Upload started\")","    }","","    func uploadDidFinish(result: Med42UploadResult) {","        switch result {","            case .success, .nothingToUpload:","                print(\"Upload completed\")","            case .failed(let error), .partialSuccess(_, let error):","                print(\"Upload failed: \\(error)\")","        }","    }","}"],"type":"codeListing"},{"anchor":"Checking-SDK-Status","type":"heading","level":2,"text":"Checking SDK Status"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Check Bluetooth and background scanning is supported:"}]},{"syntax":"swift","code":["if !Med42.shared.isBackgroundScanningAvailable() {","    print(\"Device does not support background beacon scanning\")","}","","if !Med42.shared.isBluetoothEnabled() {","    print(\"Bluetooth is not enabled\")","}"],"type":"codeListing"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","title":"Getting Started with Med42SDK","roleHeading":"Article","modules":[{"name":"Med42SDK"}]},"sections":[],"abstract":[{"text":"Learn how to integrate and use Med42SDK in your iOS application.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Med42SDK\/documentation\/Med42SDK"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/Med42SDK\/documentation\/Med42SDK\/Med42","doc:\/\/Med42SDK\/documentation\/Med42SDK\/Med42Configuration","doc:\/\/Med42SDK\/documentation\/Med42SDK\/Med42TagScannerDelegate","doc:\/\/Med42SDK\/documentation\/Med42SDK\/Med42UploadDelegate"],"title":"Related Documentation","anchor":"Related-Documentation"}],"variants":[{"paths":["\/documentation\/med42sdk\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Med42SDK\/documentation\/Med42SDK\/GettingStarted"},"references":{"doc://Med42SDK/documentation/Med42SDK/Med42TagScannerDelegate":{"navigatorTitle":[{"kind":"identifier","text":"Med42TagScannerDelegate"}],"role":"symbol","identifier":"doc:\/\/Med42SDK\/documentation\/Med42SDK\/Med42TagScannerDelegate","url":"\/documentation\/med42sdk\/med42tagscannerdelegate","title":"Med42TagScannerDelegate","kind":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Med42TagScannerDelegate"}],"type":"topic"},"doc://Med42SDK/documentation/Med42SDK/Med42UploadDelegate":{"identifier":"doc:\/\/Med42SDK\/documentation\/Med42SDK\/Med42UploadDelegate","title":"Med42UploadDelegate","kind":"symbol","abstract":[],"type":"topic","role":"symbol","navigatorTitle":[{"text":"Med42UploadDelegate","kind":"identifier"}],"url":"\/documentation\/med42sdk\/med42uploaddelegate","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Med42UploadDelegate","kind":"identifier"}]},"https://developer.apple.com/documentation/uikit/using-background-tasks-to-update-your-app":{"title":"Apple’s Docs","titleInlineContent":[{"type":"text","text":"Apple’s Docs"}],"identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/using-background-tasks-to-update-your-app","url":"https:\/\/developer.apple.com\/documentation\/uikit\/using-background-tasks-to-update-your-app","type":"link"},"doc://Med42SDK/documentation/Med42SDK":{"url":"\/documentation\/med42sdk","abstract":[{"type":"text","text":"A Swift SDK for detecting and reporting System Loco S14BLs to LocoAware."}],"role":"collection","identifier":"doc:\/\/Med42SDK\/documentation\/Med42SDK","type":"topic","title":"Med42SDK","kind":"symbol"},"doc://Med42SDK/documentation/Med42SDK/Med42Configuration":{"role":"symbol","type":"topic","url":"\/documentation\/med42sdk\/med42configuration","title":"Med42Configuration","navigatorTitle":[{"text":"Med42Configuration","kind":"identifier"}],"identifier":"doc:\/\/Med42SDK\/documentation\/Med42SDK\/Med42Configuration","kind":"symbol","abstract":[{"text":"Configuration for Med42SDK","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Med42Configuration","kind":"identifier"}]},"doc://Med42SDK/documentation/Med42SDK/Med42":{"url":"\/documentation\/med42sdk\/med42","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Med42","kind":"identifier"}],"role":"symbol","title":"Med42","navigatorTitle":[{"text":"Med42","kind":"identifier"}],"kind":"symbol","abstract":[],"identifier":"doc:\/\/Med42SDK\/documentation\/Med42SDK\/Med42"},"https://github.com/systemloco/Med42-iOS-SDK/tree/main/Med42SDK%20Example":{"titleInlineContent":[{"type":"text","text":"example app"}],"type":"link","identifier":"https:\/\/github.com\/systemloco\/Med42-iOS-SDK\/tree\/main\/Med42SDK%20Example","title":"example app","url":"https:\/\/github.com\/systemloco\/Med42-iOS-SDK\/tree\/main\/Med42SDK%20Example"}}}
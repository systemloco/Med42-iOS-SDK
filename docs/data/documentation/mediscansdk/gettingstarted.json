configuration)"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Setting Up Scanning","anchor":"Setting-Up-Scanning"},{"type":"paragraph","inlineContent":[{"text":"Implement the ","type":"text"},{"identifier":"doc:\/\/MediscanSDK\/documentation\/MediscanSDK\/BeaconScannerDelegate","type":"reference","isActive":true},{"text":" to receive beacon detection events:","type":"text"}]},{"code":["class MyViewController: UIViewController, BeaconScannerDelegate {","    override func viewDidLoad() {","        super.viewDidLoad()","","        \/\/ Set up the delegate","        Mediscan.shared.delegate = self","","        \/\/ Set username for tracking","        Mediscan.shared.username = \"user@example.com\"","","        \/\/ Initialize and start scanning","        if Mediscan.shared.initialize() {","            _ = Mediscan.shared.startForegroundScanning()","        }","    }","","    func didDetectBeacon(_ beacon: MediscanBeacon) {","        print(\"Detected beacon: \\(beacon)\")","    }","","    func didFailWithError(_ error: Error) {","        print(\"Scanning error: \\(error)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Background Scanning","type":"heading","level":2,"anchor":"Background-Scanning"},{"type":"paragraph","inlineContent":[{"text":"To enable background scanning, request permissions and register for background uploads:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Request background permissions","Mediscan.shared.requestBackgroundPermissions()","","\/\/ Register for background uploads","Mediscan.shared.registerBackgroundUpload()"]},{"text":"Uploading Beacon Data","type":"heading","level":2,"anchor":"Uploading-Beacon-Data"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Manually trigger uploads of collected beacon data:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Set upload delegate","Mediscan.shared.uploadDelegate = self","","\/\/ Trigger upload","Mediscan.shared.uploadBeacons()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MediscanSDK\/documentation\/MediscanSDK\/MediscanUploadDelegate"},{"type":"text","text":" to monitor upload status:"}]},{"syntax":"swift","type":"codeListing","code":["extension MyViewController: MediscanUploadDelegate {","    func uploadDidStart() {","        print(\"Upload started\")","    }","","    func uploadDidComplete() {","        print(\"Upload completed\")","    }","","    func uploadDidFail(error: Error) {","        print(\"Upload failed: \\(error)\")","    }","}"]},{"text":"Checking SDK Status","type":"heading","level":2,"anchor":"Checking-SDK-Status"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get statistics about beacon collection:"}]},{"type":"codeListing","syntax":"swift","code":["let stats = Mediscan.shared.getSdkStats()","print(\"Total recorded: \\(stats.totalRecorded)\")","print(\"Total sent: \\(stats.totalSent)\")","print(\"Total unsent: \\(stats.totalUnsent)\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Check Bluetooth and device support:"}]},{"type":"codeListing","syntax":"swift","code":["if !Mediscan.shared.isSupported() {","    print(\"Device does not support beacon scanning\")","}","","if !Mediscan.shared.isBluetoothEnabled() {","    print(\"Bluetooth is not enabled\")","}"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mediscansdk\/gettingstarted"]}],"references":{"doc://MediscanSDK/documentation/MediscanSDK/Mediscan":{"abstract":[],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Mediscan","kind":"identifier"}],"identifier":"doc:\/\/MediscanSDK\/documentation\/MediscanSDK\/Mediscan","kind":"symbol","navigatorTitle":[{"text":"Mediscan","kind":"identifier"}],"title":"Mediscan","type":"topic","role":"symbol","url":"\/documentation\/mediscansdk\/mediscan"},"doc://MediscanSDK/documentation/Me
an.configure(with: configuration)"],"syntax":"swift"},{"text":"Setting Up Scanning","type":"heading","anchor":"Setting-Up-Scanning","level":2},{"type":"paragraph","inlineContent":[{"text":"Implement the ","type":"text"},{"identifier":"doc:\/\/MediscanSDK\/documentation\/MediscanSDK\/BeaconScannerDelegate","isActive":true,"type":"reference"},{"text":" to receive beacon detection events:","type":"text"}]},{"type":"codeListing","code":["class MyViewController: UIViewController, BeaconScannerDelegate {","    override func viewDidLoad() {","        super.viewDidLoad()","","        \/\/ Set up the delegate","        Mediscan.shared.delegate = self","","        \/\/ Set username for tracking","        Mediscan.shared.username = \"user@example.com\"","","        \/\/ Initialize and start scanning","        if Mediscan.shared.initialize() {","            _ = Mediscan.shared.startForegroundScanning()","        }","    }","","    func didDetectBeacon(_ beacon: MediscanBeacon) {","        print(\"Detected beacon: \\(beacon)\")","    }","","    func didFailWithError(_ error: Error) {","        print(\"Scanning error: \\(error)\")","    }","}"],"syntax":"swift"},{"text":"Background Scanning","type":"heading","anchor":"Background-Scanning","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To enable background scanning, request permissions and register for background uploads:"}]},{"type":"codeListing","code":["\/\/ Request background permissions","Mediscan.shared.requestBackgroundPermissions()","","\/\/ Register for background uploads","Mediscan.shared.registerBackgroundUpload()"],"syntax":"swift"},{"text":"Uploading Beacon Data","type":"heading","anchor":"Uploading-Beacon-Data","level":2},{"type":"paragraph","inlineContent":[{"text":"Manually trigger uploads of collected beacon data:","type":"text"}]},{"type":"codeListing","code":["\/\/ Set upload delegate","Mediscan.shared.uploadDelegate = self","","\/\/ Trigger upload","Mediscan.shared.uploadBeacons()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement "},{"identifier":"doc:\/\/MediscanSDK\/documentation\/MediscanSDK\/MediscanUploadDelegate","isActive":true,"type":"reference"},{"type":"text","text":" to monitor upload status:"}]},{"type":"codeListing","code":["extension MyViewController: MediscanUploadDelegate {","    func uploadDidStart() {","        print(\"Upload started\")","    }","","    func uploadDidComplete() {","        print(\"Upload completed\")","    }","","    func uploadDidFail(error: Error) {","        print(\"Upload failed: \\(error)\")","    }","}"],"syntax":"swift"},{"text":"Checking SDK Status","type":"heading","anchor":"Checking-SDK-Status","level":2},{"type":"paragraph","inlineContent":[{"text":"Get statistics about beacon collection:","type":"text"}]},{"type":"codeListing","code":["let stats = Mediscan.shared.getSdkStats()","print(\"Total recorded: \\(stats.totalRecorded)\")","print(\"Total sent: \\(stats.totalSent)\")","print(\"Total unsent: \\(stats.totalUnsent)\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Check Bluetooth and device support:"}]},{"type":"codeListing","code":["if !Mediscan.shared.isSupported() {","    print(\"Device does not support beacon scanning\")","}","","if !Mediscan.shared.isBluetoothEnabled() {","    print(\"Bluetooth is not enabled\")","}"],"syntax":"swift"}]}],"identifier":{"url":"doc:\/\/MediscanSDK\/documentation\/MediscanSDK\/GettingStarted","interfaceLanguage":"swift"},"references":{"doc://MediscanSDK/documentation/MediscanSDK/Mediscan":{"kind":"symbol","url":"\/documentation\/mediscansdk\/mediscan","identifier":"doc:\/\/MediscanSDK\/documentation\/MediscanSDK\/Mediscan","type":"topic","title":"Mediscan","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Mediscan"}],"navigatorTitle":[{"kind":"identifier","text":"Mediscan"}],"role":"symbol","abstract":[]},"doc://MediscanSDK/documentation/Me
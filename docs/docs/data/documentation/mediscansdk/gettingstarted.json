{"variants":[{"paths":["\/documentation\/mediscansdk\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/GettingStarted"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"MediscanSDK enables your application to scan for Bluetooth beacons, track their data, and upload the information to the Mediscan platform."}]},{"type":"heading","level":2,"anchor":"Installation","text":"Installation"},{"type":"paragraph","inlineContent":[{"text":"Add MediscanSDK to your project using Swift Package Manager:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/your-org\/MediscanSDK.git\", from: \"1.0.0\")","]"]},{"type":"heading","level":2,"anchor":"Configuration","text":"Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure the SDK with your API credentials before use:"}]},{"type":"codeListing","syntax":"swift","code":["import MediscanSDK","","\/\/ Configure the SDK with your credentials","let configuration = MediscanConfiguration(","    apiKey: \"your-api-key\",","    clientId: \"your-client-id\"",")","","Mediscan.configure(with: configuration)"]},{"type":"heading","level":2,"anchor":"Setting-Up-Scanning","text":"Setting Up Scanning"},{"type":"paragraph","inlineContent":[{"text":"Implement the ","type":"text"},{"identifier":"doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/BeaconScannerDelegate","isActive":true,"type":"reference"},{"text":" to receive beacon detection events:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["class MyViewController: UIViewController, BeaconScannerDelegate {","    override func viewDidLoad() {","        super.vi
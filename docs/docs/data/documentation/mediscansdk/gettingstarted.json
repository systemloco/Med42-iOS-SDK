{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"MediscanSDK enables your application to scan for Bluetooth beacons, track their data, and upload the information to the Mediscan platform."}],"type":"paragraph"},{"text":"Installation","anchor":"Installation","level":2,"type":"heading"},{"inlineContent":[{"text":"Add MediscanSDK to your project using Swift Package Manager:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/your-org\/MediscanSDK.git\", from: \"1.0.0\")","]"],"type":"codeListing"},{"text":"Configuration","anchor":"Configuration","level":2,"type":"heading"},{"inlineContent":[{"text":"Configure the SDK with your API credentials before use:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import MediscanSDK","","\/\/ Configure the SDK with your credentials","let configuration = MediscanConfiguration(","    apiKey: \"your-api-key\",","    clientId: \"your-client-id\"",")","","Mediscan.configure(with: configuration)"],"type":"codeListing"},{"text":"Setting Up Scanning","anchor":"Setting-Up-Scanning","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Implement the "},{"identifier":"doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/BeaconScannerDelegate","type":"reference","isActive":true},{"type":"text","text":" to receive beacon detection events:"}],"type":"paragraph"},{"syntax":"swift","code":["class MyViewController: UIViewController, BeaconScannerDelegate {","    override func viewDidLoad() {","        super.viewDidLoad()","","        \/\/ Set up the delegate","        Mediscan.shared.delegate = self","","        \/\/ Set username for tracking","        Mediscan.shared.username = \"user@example.com\"","","        \/\/ Initialize and start scanning","        if Mediscan.shared.initialize() {","            _ = Mediscan.shared.startForegroundScanning()","        }","    }","","    func didDetectBeacon(_ beacon: MediscanBeacon) {","        print(\"Detected beacon: \\(beacon)\")","    }","","    func didFailWithError(_ error: Error) {","        print(\"Scanning error: \\(error)\")","    }","}"],"type":"codeListing"},{"text":"Background Scanning","anchor":"Background-Scanning","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To enable background scanning, request permissions and register for background uploads:"}]},{"code":["\/\/ Request background permissions","Mediscan.shared.requestBackgroundPermissions()","","\/\/ Register for background uploads","Mediscan.shared.registerBackgroundUpload()"],"syntax":"swift","type":"codeListing"},{"text":"Uploading Beacon Data","anchor":"Uploading-Beacon-Data","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Manually trigger uploads of collected beacon data:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Set upload delegate","Mediscan.shared.uploadDelegate = self","","\/\/ Trigger upload","Mediscan.shared.uploadBeacons()"]},{"inlineContent":[{"text":"Implement ","type":"text"},{"identifier":"doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/MediscanUploadDelegate","isActive":true,"type":"reference"},{"text":" to monitor upload status:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension MyViewController: MediscanUploadDelegate {","    func uploadDidStart() {","        print(\"Upload started\")","    }","","    func uploadDidComplete() {","        print(\"Upload completed\")","    }","","    func uploadDidFail(error: Error) {","        print(\"Upload failed: \\(error)\")","    }","}"]},{"text":"Checking SDK Status","type":"heading","level":2,"anchor":"Checking-SDK-Status"},{"inlineContent":[{"type":"text","text":"Get statistics about beacon collection:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let stats = Mediscan.shared.getSdkStats()","print(\"Total recorded: \\(stats.totalRecorded)\")","print(\"Total sent: \\(stats.totalSent)\")","print(\"Total unsent: \\(stats.totalUnsent)\")"]},{"inlineContent":[{"type":"text","text":"Check Bluetooth and device support:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["if !Mediscan.shared.isSupported() {","    print(\"Device does not support beacon scanning\")","}","","if !Mediscan.shared.isBluetoothEnabled() {","    print(\"Bluetooth is not enabled\")","}"]}],"kind":"content"}],"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"MediscanSDK"}],"role":"article","title":"Getting Started with MediscanSDK"},"hierarchy":{"paths":[["doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK"]]},"kind":"article","abstract":[{"type":"text","text":"Learn how to integrate and use MediscanSDK in your iOS application."}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/Mediscan","doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/MediscanConfiguration","doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/BeaconScannerDelegate","doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/MediscanUploadDelegate"],"title":"Related Documentation"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mediscansdk\/gettingstarted"]}],"identifier":{"url":"doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/GettingStarted","interfaceLanguage":"swift"},"references":{"doc://mediscansdk.MediscanSDK/documentation/MediscanSDK/MediscanConfiguration":{"title":"MediscanConfiguration","identifier":"doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/MediscanConfiguration","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MediscanConfiguration"}],"abstract":[{"text":"Configura
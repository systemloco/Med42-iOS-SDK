 {","        print(\"Upload failed: \\(error)\")","    }","}"]},{"type":"heading","text":"Checking SDK Status","level":2,"anchor":"Checking-SDK-Status"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get statistics about beacon collection:"}]},{"syntax":"swift","type":"codeListing","code":["let stats = Mediscan.shared.getSdkStats()","print(\"Total recorded: \\(stats.totalRecorded)\")","print(\"Total sent: \\(stats.totalSent)\")","print(\"Total unsent: \\(stats.totalUnsent)\")"]},{"type":"paragraph","inlineContent":[{"text":"Check Bluetooth and device support:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["if !Mediscan.shared.isSupported() {","    print(\"Device does not support beacon scanning\")","}","","if !Mediscan.shared.isBluetoothEnabled() {","    print(\"Bluetooth is not enabled\")","}"]}]}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/Mediscan","doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/MediscanConfiguration","doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/BeaconScannerDelegate","doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK\/MediscanUploadDelegate"],"anchor":"Related-Documentation"}],"hierarchy":{"paths":[["doc:\/\/mediscansdk.MediscanSDK\/documentation\/MediscanSDK"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"MediscanSDK"}],"title":"Getting Started with MediscanSDK","role":"article"},"kind":"article","abstract":[{"text":"Learn how to integrate and use MediscanSDK in your iOS application.","type":"text"}],"references":{"doc://mediscansdk.MediscanSDK/documentation/MediscanSDK/BeaconScannerDelegate":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BeaconScannerDelegate"}],"navigatorTitle":[{"kind":"identifier","text":"BeaconScannerDelegate"}],"role":"symbol","url":"\/documentation\/mediscansdk\/beaconscannerdele
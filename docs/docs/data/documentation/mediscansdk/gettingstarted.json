{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MediscanSDK\/documentation\/MediscanSDK\/GettingStarted"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"MediscanSDK enables your application to scan for Bluetooth beacons, track their data, and upload the information to the Mediscan platform."}]},{"type":"heading","text":"Installation","level":2,"anchor":"Installation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add MediscanSDK to your project using Swift Package Manager:"}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/your-org\/MediscanSDK.git\", from: \"1.0.0\")","]"]},{"type":"heading","text":"Configuration","level":2,"anchor":"Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure the SDK with your API credentials before use:"}]},{"type":"codeListing","syntax":"swift","code":["import MediscanSDK","","\/\/ Configure the SDK with your credentials","let configuration = MediscanConfiguration(","    apiKey: \"your-api-key\",","    clientId: \"your-client-id\"",")","","Mediscan.configure(with: configuration)"]},{"type":"heading","text":"Setting Up Scanning","level":2,"anchor":"Setting-Up-Scanning"},{"type":"paragraph","inlineContent":[{"text":"Implement the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MediscanSDK\/documentation\/MediscanSDK\/BeaconScannerDelegate"},{"text":" to receive beacon detection events:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["class MyViewController: UIViewController, BeaconScannerDelegate {","    override func viewDidLoad() {","        super.viewDidLoad()","","        \/\/ Set up the delegate","        Mediscan.shared.delegate = self","","        \/\/ Set username for tracking","        Medis